# ==============================================================================
# ALSEK PULSE - CONFIGURATION ENVIRONNEMENT (Docker Compose & Local Dev)
# ==============================================================================

# 1. PostgreSQL 16
DB_USER=alsek_admin
DB_PASSWORD=alsek_pulse_secret_db_2026
DB_NAME=alsek_pulse
DATABASE_URL="postgresql://alsek_admin:alsek_pulse_secret_db_2026@localhost:5432/alsek_pulse?schema=public"

# 2. Redis & BullMQ Worker
REDIS_PASSWORD=alsek_pulse_secret_redis_2026
REDIS_URL="redis://:alsek_pulse_secret_redis_2026@localhost:6379"

# 3. Authentification Super-Admin (Auth.js / NextAuth)
AUTH_SECRET=remplacer_par_une_cle_aleatoire_32_caracteres_minimum
NEXTAUTH_SECRET=remplacer_par_une_cle_aleatoire_32_caracteres_minimum
ADMIN_EMAIL=contact@alsek.fr
ADMIN_INITIAL_PASSWORD=AlsekPulse2026!Admin

# 4. Dynamic White-Labeling (Multi-Domaines Traefik)
DOMAIN_ALSEK=app.alsek.fr
DOMAIN_VITRINE=pro.vitrine-caladoise.fr

# 5. Connecteurs Externes (Optionnels - Fallbacks intelligents intégrés)
GOOGLE_PLACES_API_KEY=
APIFY_API_TOKEN=
